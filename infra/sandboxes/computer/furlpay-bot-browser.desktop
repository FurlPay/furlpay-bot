[Desktop Entry]
Type=Application
Name=FurlPay Bot Browser
Comment=Chromium with FurlPay Bot container flags and profile isolation
Exec=/usr/local/bin/furlpay-bot-browser %U
Terminal=false
Categories=Network;WebBrowser;
